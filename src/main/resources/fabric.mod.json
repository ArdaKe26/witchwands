{
	"schemaVersion": 1,
	"id": "witchwands",
	"version": "${version}",
	"name": "Witch Wands",
	"description": "Adds magical witch wands to Minecraft. The Fire Wand launches explosive fireballs that don't break blocks, and Shift + right-click ignites every mob around you. Ice, Teleport and Soil wands are coming soon.",
	"authors": [
		"arda.kurtulus"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/witch-wands",
		"sources": "https://github.com/ArdaKe26/witchwands"
	},
	"license": "MIT",
	"icon": "assets/witchwands/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.admin.witchwands.WitchWands"
		],
		"client": [
			"com.admin.witchwands.client.WitchWandsClient"
		]
	},
	"mixins": [
		"witchwands.mixins.json",
		{
			"config": "witchwands.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}